{
  "name": "jhb-admin-dashboard-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Windows launcher for the JHB Admin Dashboard (Next.js + Supabase)",
  "main": "main.js",
  "author": "JHB Automations",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jhb.admindashboard",
    "productName": "AdminDashboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "AdminDashboard.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AdminDashboard-Setup.exe",
      "shortcutName": "JHB Admin Dashboard"
    }
  }
}
