# dependencies
node_modules/
**/node_modules/

# next.js
.next/
**/.next/
out/
**/out/

# production
build/
dist/

# env
.env
.env*.local
**/.env*.local

# misc
.DS_Store
*.pem

# stray nested clone (its own git repo — not part of this project)
claude-seo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# deploy artifacts (regenerated by `npm run build:website` / deploy.ps1)
website-hostinger.zip
*-hostinger.zip
# Hostinger FTP deploy: staging copy + zips are throwaway; password never committed
apps/website/deploy/public_html/
apps/website/deploy/*.zip
apps/website/deploy/.ftp-pass

# Never commit or serve archives from the public root — anything here is served at
# the site root, so a stray project zip would be publicly downloadable (and could
# leak its bundled .env / source / git history).
apps/website/public/*.zip

# typescript
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# launcher binary (regenerate via launcher/ npm run dist)
AdminDashboard.exe
launcher/dist/
launcher/node_modules/

# Local dev server logs (large, machine-specific)
.website-dev.log
.website-dev-error.log
