# Loaded automatically by `next build` (production) for the website.
# Keeps the shared Supabase client COOKIELESS (anon, public reads). The public
# site never needs auth, and a cookieless client avoids opting routes into fully
# dynamic rendering — so ISR caching works (see app/layout.tsx `revalidate`).
# NOTE: despite the name, the site is no longer statically exported — it runs on
# the Netlify Next.js runtime (SSR/ISR). See packages/shared/src/supabase/server.ts.
STATIC_EXPORT=true
# Absolute base URL used for canonical tags, Open Graph, sitemap.xml, robots.txt.
NEXT_PUBLIC_SITE_URL=https://jhbautomations.com
