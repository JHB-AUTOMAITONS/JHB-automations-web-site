# Loaded automatically by `next build` (production) for the website.
# STATIC_EXPORT makes the shared Supabase client cookieless so public content
# can be read at build time (see packages/shared/src/supabase/server.ts).
STATIC_EXPORT=true
# Absolute base URL used for canonical tags, Open Graph, sitemap.xml, robots.txt.
NEXT_PUBLIC_SITE_URL=https://jhbautomations.com
