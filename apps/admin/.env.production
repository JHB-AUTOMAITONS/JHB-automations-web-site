# Loaded automatically by `next build` (production) for the admin app.
# The "View on website" links in the admin point at the live public site.
# NOTE: Supabase URL/anon key are NOT here — set them as environment variables
# on the Netlify admin site (they normally live in git-ignored .env.local).
# Do NOT add STATIC_EXPORT — the admin must use the cookie-aware Supabase client.
NEXT_PUBLIC_WEBSITE_URL=https://jhbautomations.com
