# Loaded automatically by `next build` (production) for the admin app, so the
# Netlify deploy bakes these in — no Netlify dashboard env vars required.
#
# These NEXT_PUBLIC_* values are PUBLIC by design (the publishable/anon key is
# meant for browsers and already ships in the public site's JS bundle; RLS is
# what protects your data). Safe to commit.
#
# Do NOT add STATIC_EXPORT here — the admin must use the cookie-aware Supabase
# client for login/sessions.
NEXT_PUBLIC_SUPABASE_URL=https://ossvdnwcmsjbdlstldhh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_g5cfiCfFMfCzjSdHPrK2iw_6sIbp0Cy
NEXT_PUBLIC_WEBSITE_URL=https://jhbautomations.com

# Publish -> live cache purge. Set REVALIDATE_SECRET (a long random string) in the
# Netlify dashboard for THIS admin site AND the website (same value on both) —
# it's a SECRET, so it is NOT committed here. After a publish, the admin POSTs it
# to ${NEXT_PUBLIC_WEBSITE_URL}/api/revalidate to purge the live cache instantly.
# Without it, publishing still works but the site refreshes on its ~30s ISR timer.
